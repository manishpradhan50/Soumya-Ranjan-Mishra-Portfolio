rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    /*
      Public profile images can be viewed by everyone.
    */

    match /profile-images/{allPaths=**} {

      allow read: if true;

      /*
        Only authenticated profile owner can upload, update or delete images.
        Validates owner role in Firestore admins collection, restricts size to <= 5MB,
        and enforces image MIME type.
      */

      allow write: if request.auth != null
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/admins/$(request.auth.uid)
        ).data.role == 'owner'
        && (
          !('active' in firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data)
          || firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }


    /*
      Deny everything else.
    */

    match /{allPaths=**} {

      allow read, write: if false;
    }
  }
}