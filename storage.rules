rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    /*
      Public profile images can be viewed by everyone.
    */

    match /profile-images/{allPaths=**} {

      allow read: if true;

      /*
        Only authenticated profile owner can upload,
        update or delete images.
      */

      allow write: if request.auth != null
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/admins/$(request.auth.uid)
        ).data.active == true;
    }


    /*
      Deny everything else.
    */

    match /{allPaths=**} {

      allow read, write: if false;
    }
  }
}