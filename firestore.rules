rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
      PUBLIC PORTFOLIO DATA

      Everyone can READ the public portfolio collections.

      Only the authenticated profile owner can:
      - create
      - update
      - delete
    */

    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner'
        )
        && (
          !('active' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        );
    }


    /* ================= PROFILE ================= */

    match /profile/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }


    /* ================= EXPERIENCE ================= */

    match /experiences/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /experience/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }


    /* ================= EDUCATION ================= */

    match /education/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }


    /* ================= RESEARCH ================= */

    match /research/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }


    /* ================= PUBLICATIONS ================= */

    match /publications/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }


    /* ================= ACHIEVEMENTS ================= */

    match /achievements/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }


    /* ================= SKILLS ================= */

    match /skills/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }


    /* ================= CERTIFICATIONS ================= */

    match /certifications/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }


    /* ================= ADMIN ================= */

    /*
      The owner document itself cannot be modified from the client SDK.
      Only the authenticated user can read their own admin doc to verify their role.
      You create it manually from Firebase Console or via Admin SDK.
    */

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }


    /* ================= DEFAULT DENY ================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}